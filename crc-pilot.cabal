cabal-version: 3.0
name: crc-pilot
version: 0.1.0.0
build-type: Simple

executable crc-server
  main-is: Server.hs
  hs-source-dirs: haskell
  other-modules: CRC
  default-language: Haskell2010
  ghc-options: -Wall -O2 -threaded
  build-depends: base >= 4.20 && < 5, bytestring, http-types, wai, warp
